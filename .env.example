# Base URL for the API. Leave as /api while MSW is answering requests.
VITE_API_BASE_URL=/api

# Set to false once a real backend is available.
VITE_USE_MOCKS=true

# Milliseconds of artificial delay on mock writes. 0 (the default) is instant;
# set e.g. 700 when you want to watch loading and in-flight states.
VITE_MOCK_LATENCY=0
